                { "caption": "Schritt", "name": "Step", "width": "70px", "add": 1, "edit": { "type": "NumberSpinner", "digits": 1 } },
                { "caption": "Min", "name": "Min", "width": "70px", "add": 0, "edit": { "type": "NumberSpinner", "digits": 1 } },
                { "caption": "Max", "name": "Max", "width": "70px", "add": 100, "edit": { "type": "NumberSpinner", "digits": 1 } },
