                { "caption": "Bezeichnung", "name": "Caption", "width": "auto", "add": "", "edit": { "type": "ValidationTextBox" } }
            ] }
        ] },
        { "type": "Label", "caption": "Verlauf: Vorlauf, Rücklauf und Warmwasser der letzten 24 h aus dem Archiv (5-Minuten-Mittel), alle 5 Minuten aktualisiert. Farben aus „Visu Design“." }
