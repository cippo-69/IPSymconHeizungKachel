                { "caption": "Art", "name": "Type", "width": "130px", "add": "toggle", "edit": { "type": "Select", "options": [
                    { "caption": "Umschalten", "value": "toggle" },
                    { "caption": "Taste", "value": "button" },
                    { "caption": "Stufen", "value": "step" }
                ] } },
                { "caption": "Objekt", "name": "ObjectID", "width": "220px", "add": 0, "edit": { "type": "SelectObject" } },
                { "caption": "Objekt 2", "name": "ObjectID2", "width": "220px", "add": 0, "edit": { "type": "SelectObject" } },
                { "caption": "Status", "name": "StateID", "width": "220px", "add": 0, "edit": { "type": "SelectVariable" } },
